PORT=5000
NODE_ENV=development

MONGO_URI_LOGIN=mongodb+srv://<db-user>:<password>@cluster0.tfgc1ve.mongodb.net/Login?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=<time>

JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=<time>
BCRYPT_COST_FACTOR=<count>

# OTP settings (forgot password flow)
OTP_EXPIRY_MINUTES=<time>
OTP_MAX_ATTEMPTS=<time>

CLIENT_URL=<hosted-url>
# Internal-only route protection (server calling its own token route)
SERVER_BASE_URL=<hosted-url>
INTERNAL_API_SECRET=replace_with_a_different_long_random_string

EMAIL_USER=<user-email>
GMAIL_APP_PASSWORD=<user-app-password>
EMAIL_FROM=<app enail>

# Account lockout policy
MAX_FAILED_LOGIN_ATTEMPTS=<count>
ACCOUNT_LOCK_DURATION_MINUTES=<time>