PORT=5000
NODE_ENV=development

# Database URIs
MONGO_URI=mongodb+srv://<db-user>:<password>@cluster0.tfgc1ve.mongodb.net/WaveSafe?retryWrites=true&w=majority
MONGO_URI_LOGIN=mongodb+srv://<db-user>:<password>@cluster0.tfgc1ve.mongodb.net/Login?retryWrites=true&w=majority
MONGO_URI_REPORTS=mongodb+srv://<db-user>:<password>@cluster0.tfgc1ve.mongodb.net/Reports?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_COST_FACTOR=12

# Internal-only route protection
SERVER_BASE_URL=http://localhost:5000
INTERNAL_API_SECRET=replace_with_a_different_long_random_string

# Email delivery (Resend / SMTP)
RESEND_API_KEY=your_resend_api_key
EMAIL_USER=your_email_address
GMAIL_APP_PASSWORD=your_app_password
EMAIL_FROM=no-reply@yourapp.com

# OTP settings (forgot password flow)
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

CLIENT_URL=http://localhost:3000

# Account lockout policy
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15

# Cloudinary (media storage for report files)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret